# Firebase Web App Configuration
# Get these from your Firebase Console:
# 1. Go to https://console.firebase.google.com/
# 2. Select your Project -> Project Settings (gear icon) -> General
# 3. Under "Your apps", select your Web App (or click "</>" to register one)
# 4. Copy the values from the firebaseConfig object below:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Set to 'true' to connect directly to the local Firebase Emulator Suite
# (Firestore port 8080, Auth port 9099). If true or if credentials above are unset,
# the app will connect to the local emulator.
VITE_USE_FIREBASE_EMULATOR=false
